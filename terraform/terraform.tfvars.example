# 이 파일을 terraform.tfvars 로 복사해서 쓴다 (terraform.tfvars 는 git에 올리지 않는다)
# 기본값과 같으면 비워 둬도 된다. 비밀번호·시크릿은 여기에 쓰지 말고 SSM Parameter Store에 넣는다.
project     = "pharmlink"
environment = "prod"
aws_region  = "ap-northeast-2"
github_org  = "MJ-PharmLink"

# CloudWatch 알람 메일 받을 주소 (필수, 여러 개 가능)
alert_emails = ["me@example.com"]
